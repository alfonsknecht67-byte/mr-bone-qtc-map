{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mr. Bone Public Bubble Map",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "source",
    "attribution",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "generated_at": {
      "type": ["string", "null"]
    },
    "source": {
      "type": "string"
    },
    "verified_block": {
      "type": ["integer", "null"]
    },
    "balance_definition": {
      "type": ["object", "null"],
      "properties": {
        "field": { "type": "string" },
        "source": { "type": "string" },
        "rule": { "type": ["string", "null"] },
        "verified_against_node": { "type": "boolean" },
        "verified_block": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "heuristic_notice": {
      "type": ["string", "null"]
    },
    "graph_scope": {
      "type": "object",
      "required": ["visualized_nodes", "visualized_edges", "funded_addresses_only", "note"],
      "properties": {
        "visualized_nodes": { "type": "integer", "minimum": 0 },
        "visualized_edges": { "type": "integer", "minimum": 0 },
        "funded_addresses_only": { "type": "boolean" },
        "minimum_edge_qtc": { "type": ["number", "null"], "minimum": 0 },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "live_stats": {
      "type": ["object", "null"],
      "properties": {
        "known_addresses": { "type": "number", "minimum": 0 },
        "active_wallets": { "type": "number", "minimum": 0 },
        "total_utxo_qtc": { "type": "number", "minimum": 0 },
        "latest_indexed_block": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "attribution": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "full_address",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "full_address": {
            "type": "string"
          },
          "type": {
            "const": "address"
          },
          "balance": {
            "type": ["number", "null"]
          },
          "received": {
            "type": ["number", "null"]
          },
          "sent": {
            "type": ["number", "null"]
          },
          "tx_count": {
            "type": ["number", "null"]
          },
          "size": {
            "type": ["number", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "value": {
            "type": ["number", "null"]
          },
          "count": {
            "type": ["number", "null"]
          },
          "first_block": {
            "type": ["integer", "null"]
          },
          "last_block": {
            "type": ["integer", "null"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
